# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/template_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/template_db?schema=public"

# NextAuth Secret
AUTH_SECRET="your-auth-secret"

# App URL (招待メールなどのリンク生成に使用。本番環境では https://your-domain.com を設定)
APP_URL="http://localhost:3000"

# ==============================================================================
# SMTP Configuration
# ==============================================================================

# 【ローカル開発環境 (Mailpit)】
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="Local Sender<noreply@email.local>"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"

# 【本番環境 (Resend)】
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="465"
# SMTP_USER="resend"
# SMTP_PASS="re_xxxxxxxxxxxx"
# SMTP_FROM="Sender Name<onboarding@resend.dev>"
# SMTP_SECURE="true"

# Mailpit REST API (for local E2E testing)
MAILPIT_API_URL="http://localhost:8025/api/v1"

# Registration Mode ("public" | "invitation" | "disabled")
# public: 自由登録制（確認メール先行型、デフォルト）
# invitation: 招待制（管理者招待のみ）
# disabled: 新規受付停止
REGISTRATION_MODE="public"

